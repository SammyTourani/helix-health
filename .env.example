# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key, used only server-side to render public share pages.
# Keep this secret; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq API key, used for AI pre-appointment briefs (Llama 3.3 70B).
GROQ_API_KEY=your-groq-api-key
